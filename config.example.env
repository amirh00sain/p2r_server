# Spider WSS Tunnel — server environment
# Railway: paste the non-comment lines into "Variables" on your service.
#
# Everything below has a working default — a bare `./spider-server` boots fine.
#
# ---------------------------------------------------------------
# Networking
# ---------------------------------------------------------------
PORT=8080
# 8080 is the fixed default port. Keep PORT=8080 locally; Railway injects its
# own PORT, which the server honours automatically.
#
# TRUST_PROXY=true          # set to true behind a proxy / load balancer
# ALLOWED_ORIGINS=          # comma-separated browser origins, e.g.
#                            #   https://panel.example.com,https://status.example.com
#                            # (leave empty to allow any origin)
#
# ---------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------
# TOKEN: there is no TOKEN variable. On every start the server generates a
# fresh 256-bit random token by itself and shows it:
#   - on the web panel  -> "SERVER TOKEN" (copy button)
#   - in the startup log -> "primary token: <hex>"
#   - at /api/token
#   - ./spider-server -print-token
#
# Clients must be given the current token after each (re)start, and the token
# is NEVER sent in a URL or an HTTP header. SPIDER-SEC-3 authenticates inside
# the encrypted application handshake: the server identifies the caller by
# trial-decrypting the inner hello against its stored credentials, so the
# credential has no wire-visible form at all. The endpoint is just:
#   wss://your-host/ws
#
# PANEL password (HTTP Basic, user "admin"):
PANEL_PASSWORD=admin
# Defaults to "admin" when unset. Set your own secret on any public deploy.
# PANEL_PASSWORD=           # explicitly empty disables panel auth entirely
#                            # (only sensible on a trusted lab network)
#
# ---------------------------------------------------------------
# Data
# ---------------------------------------------------------------
# DATA_DIR=/data            # where the credential store lives (0600). Attach a
#                            # Railway volume to /data only if you issue extra
#                            # credentials at runtime; the primary token is
#                            # regenerated on every start regardless.
#
# ---------------------------------------------------------------
# Tuning (defaults in parentheses — omit to use them)
# ---------------------------------------------------------------
# MAX_CLIENTS=128
# MAX_SESSIONS=8192
# MAX_SESSIONS_PER_CLIENT=512
# HEARTBEAT_INTERVAL=20s
# DIAL_TIMEOUT=15s
# WRITE_TIMEOUT=30s
# IDLE_TIMEOUT=0            # 0 disables read deadlines
# UDP_IDLE_TIMEOUT=5m
# MAX_UDP_PACKET=65507
# BUFFER_SIZE=32768
# PANEL_LOG_LINES=500
# VERBOSE=false
#
# ---------------------------------------------------------------
# SPIDER-SEC-3 (secure handshake, record layer, traffic shaping)
# ---------------------------------------------------------------
# AEAD=aes-256-gcm          # record cipher: "aes-256-gcm" (default) or
#                            # "chacha20-poly1305". Offered inside the
#                            # encrypted inner hello and echoed back, so a
#                            # downgrade is detected.
#
# KEY_ROTATE_BYTES=1073741824   # advance the key epoch after this many bytes
# KEY_ROTATE_SECONDS=1h         # ...or this interval, whichever comes first.
#                               # At least one trigger must be positive.
#
# HANDSHAKE_RATE_LIMIT=10   # per-IP handshakes per minute. The server has no
#                            # plaintext credential selector: it identifies the
#                            # caller by deriving a candidate key for every
#                            # stored credential and trying each one, walking
#                            # the whole store so the time taken does not
#                            # reveal how many credentials exist. That loop is
#                            # measurable work, and this is what bounds it.
#
# ---------------------------------------------------------------
# Traffic shaping (OFF by default — a fixed pattern is itself detectable)
# ---------------------------------------------------------------
# PADDING_ENABLED=false     # set true to shape traffic. Sizes are drawn from
#                            # a weighted set and the interval is a uniform
#                            # draw, so there is no period to detect; a
#                            # constant frame on a fixed timer would be worse
#                            # than sending nothing.
# PADDING_SIZES=4096,16384,51200   # candidate frame lengths, strictly increasing
# PADDING_WEIGHTS=0.7,0.25,0.05    # one weight per size, must sum to 1.0
# PADDING_MIN_INTERVAL=2s   # lower bound of the random wait
# PADDING_MAX_INTERVAL=45s  # upper bound, must exceed the minimum
# PADDING_MAX_KBPS=64       # rate cap for padding; 0 disables the cap
